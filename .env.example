# Server-only Anthropic key. The app falls back to deterministic agent rules when absent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# NEAR integration mode. Intents settlement is mainnet-only; use simulated for testnet demos.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_INTENTS_MODE=simulated

# Server only NEAR testnet wallet configuration.
NEAR_NETWORK_ID=testnet
NEAR_NODE_URL=https://rpc.testnet.near.org
NEAR_PARENT_ACCOUNT_ID=
NEAR_PARENT_PRIVATE_KEY=
NEAR_USDC_CONTRACT_ID=
NEAR_AGENT_ACCOUNT_SUFFIX=
NEAR_AGENT_STARTING_NEAR=0.1
NEAR_AGENT_PRIVATE_KEYS_JSON=
NEAR_INTENTS_JWT=
NEAR_INTENTS_ORIGIN_ASSET=
NEAR_INTENTS_DESTINATION_ASSET=
NEAR_INTENTS_REFUND_ADDRESS=
NEAR_INTENTS_RECIPIENT=
ENABLE_MAINNET_INTENTS=false
NEXT_PUBLIC_NEAR_LEDGER_MODE=DEMO LEDGER
CRON_SECRET=

# Auth.js observer login. Leave blank to keep guest watch mode active.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEAR_TREASURY_ACCOUNT_ID=
NEAR_TREASURY_PRIVATE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
