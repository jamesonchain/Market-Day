# Optional server-only free provider keys. The app falls back to deterministic rules when absent.
GEMINI_API_KEY=
GROQ_API_KEY=

# Server-only NEAR testnet wallet configuration.
NEAR_NODE_URL=https://rpc.testnet.near.org
NEAR_PARENT_ACCOUNT_ID=marketday.testnet
NEAR_PARENT_PRIVATE_KEY=
NEAR_USDC_CONTRACT_ID=
NEAR_AGENT_STARTING_NEAR=0.3
NEAR_AGENT_STARTING_USDC=3
NEAR_AGENT_PRIVATE_KEYS_JSON=
NEAR_INTENTS_ORIGIN_ASSET=
NEAR_INTENTS_DESTINATION_ASSET=
NEAR_INTENTS_REFUND_ADDRESS=
NEAR_INTENTS_RECIPIENT=
CRON_SECRET=

# Auth.js observer login. GitHub and Google are optional. Guest watch always works.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Supabase is optional. Without it, local mode uses in-memory persistence.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
