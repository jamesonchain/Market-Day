    const tl = gsap.timeline({ paused: true });
    tl.fromTo(".intro-cloud-a", { x: -80, opacity: 0 }, { x: 100, opacity: .65, duration: 6, ease: "none" }, 0);
    tl.fromTo(".intro-cloud-b", { x: 80, opacity: 0 }, { x: -100, opacity: .55, duration: 6, ease: "none" }, 0);
