  </style>
  <div id="root" data-composition-id="day-intro" data-width="1080" data-height="1350">
    <div class="sky"></div><div id="intro-cloud-a" class="cloud intro-cloud-a clip" data-start="0" data-duration="6"></div><div id="intro-cloud-b" class="cloud intro-cloud-b clip" data-start="0" data-duration="6"></div><div class="grain"></div>
    <div id="intro-copy" class="intro-copy clip" data-start="0" data-duration="6"><div id="intro-tag" class="intro-tag mono clip" data-start="0" data-duration="2.4"></div><h1 id="intro-title" class="intro-title display clip" data-start="0" data-duration="4.8"></h1><p id="intro-subtitle" class="intro-subtitle body clip" data-start="0.7" data-duration="4.5"></p></div>
