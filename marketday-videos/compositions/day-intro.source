<template>
  <style>
    __THEME__
    #root { background: var(--night); }
    .intro-cloud-a { top: 25%; left: -8%; }
    .intro-cloud-b { top: 43%; right: -12%; transform: scale(.72); opacity: .55; }
    .intro-copy { left: 9%; top: 17%; width: 82%; color: var(--white); }
    .intro-title { position: relative; margin: 0; font-size: 122px; line-height: .9; letter-spacing: -.065em; text-shadow: 0 0 28px rgba(255,246,234,.24); }
    .intro-subtitle { position: relative; width: 600px; margin: 38px 0 0; font-size: 28px; line-height: 1.2; color: rgba(255,246,234,.82); }
