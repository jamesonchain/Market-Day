  </style>
  <div id="root" data-composition-id="lower-third" data-width="1080" data-height="1350">
    <div class="sky"></div><div id="lower-cloud" class="cloud lower-cloud clip" data-start="0" data-duration="3"></div>
    <div id="lower-tag" class="paper lower-tag clip" data-start="0" data-duration="3"><div class="lower-mark mono">MARKETDAY / LIVE</div><h2 id="lower-title" class="lower-title display"></h2><p id="lower-subtitle" class="lower-subtitle body"></p></div>
