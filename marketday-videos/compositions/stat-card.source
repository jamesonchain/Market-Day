<template>
  <style>
    __THEME__
    #root { background: var(--horizon); }
    .stat-sky { position: absolute; inset: 0; background: radial-gradient(circle at 70% 20%, rgba(255,246,234,.32), transparent 38%), linear-gradient(180deg, var(--rose), var(--horizon)); }
    .stat-card { left: 7%; top: 13%; width: 86%; height: 74%; padding: 72px 70px; background: var(--paper); border-radius: 44px; color: var(--ink); box-shadow: 0 24px 60px rgba(20,22,49,.22); }
    .stat-kicker { color: rgba(20,23,43,.62); font-size: 18px; }
    .stat-number { margin: 45px 0 4px; font-size: 240px; line-height: .78; letter-spacing: -.09em; color: var(--vermilion); }
    .stat-label { margin: 0; font-size: 54px; line-height: 1; letter-spacing: -.04em; }
    .stat-caption { margin: 45px 0 0; padding-top: 24px; border-top: 1px solid rgba(20,23,43,.22); font-size: 24px; color: rgba(20,23,43,.72); }
  </style>
  <div id="root" data-composition-id="stat-card" data-width="1080" data-height="1350">
    <div class="stat-sky"></div>
    <article id="stat-card-panel" class="stat-card clip" data-start="0" data-duration="4"><div class="stat-kicker mono">FIELD REPORT / 01</div><div id="stat-number" class="stat-number display"></div><h2 id="stat-label" class="stat-label display"></h2><p id="stat-caption" class="stat-caption body"></p></article>
  </div>
  <script>
    const props = __PROPS__;
    document.querySelector("#stat-number").textContent = props.number;
    document.querySelector("#stat-label").textContent = props.label;
    document.querySelector("#stat-caption").textContent = props.caption;
    const tl = gsap.timeline({ paused: true });
    tl.fromTo("#stat-card-panel", { opacity: 0, y: 70, scale: .94, rotation: -1.5 }, { opacity: 1, y: 0, scale: 1, rotation: 0, duration: .75, ease: "power3.out" }, .15);
    tl.fromTo("#stat-number", { opacity: 0, scale: .7 }, { opacity: 1, scale: 1, duration: .7, ease: "back.out(1.5)" }, .6);
    tl.fromTo("#stat-label", { opacity: 0, x: -24 }, { opacity: 1, x: 0, duration: .6, ease: "power2.out" }, 1.15);
    tl.fromTo("#stat-caption", { opacity: 0 }, { opacity: 1, duration: .6, ease: "power2.out" }, 1.75);
    window.__timelines = window.__timelines || {};
    window.__timelines["stat-card"] = tl;
  </script>
</template>
